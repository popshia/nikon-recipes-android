# Copy to keystore.properties (gitignored) and fill in. Do NOT commit the real file or the .jks.
#
# 1. Generate a keystore once (pick strong passwords, keep them safe FOREVER —
#    lose them and you can never update the app under the same signature):
#
#    keytool -genkeypair -v -keystore release.jks -alias nikon \
#      -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Put release.jks at the repo root and fill these in:
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=nikon
keyPassword=CHANGE_ME
